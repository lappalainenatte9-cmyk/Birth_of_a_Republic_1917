title: Next month
set-bg: img/map_2.jpg
is-hand: true
on-arrival: {!
// Initialize the October 1917 parliamentary composition as soon as the game
// reaches its original main hand, rather than requiring a visit to a card.
// The inherited game stores seat shares as percentages of the chamber.
if (Q.finland_1917_initialized !== 1) {
    Q.spd_r = 46;
    Q.kpd_r = 0;
    Q.z_r = 13;
    Q.ddp_r = 12;
    Q.dvp_r = 2.5;
    Q.dnvp_r = 16;
    Q.nsdap_r = 0;
    Q.other_r = 10.5;
    Q.old_spd_r = Q.spd_r;
    Q.old_kpd_r = Q.kpd_r;
    Q.old_z_r = Q.z_r;
    Q.old_ddp_r = Q.ddp_r;
    Q.old_dvp_r = Q.dvp_r;
    Q.old_dnvp_r = Q.dnvp_r;
    Q.old_nsdap_r = Q.nsdap_r;
    Q.old_other_r = Q.other_r;
    Q.finland_1917_initialized = 1;
}
if (Q.advisor_action_timer <= 0) {
    Q.pinnedCardsDescription = 'Advisors - an action is available.';
} else if (Q.advisor_action_timer == 1) {
    Q.pinnedCardsDescription = 'Advisors - next action available in 1 month.';
} else {
    Q.pinnedCardsDescription = 'Advisors - next action available in ' + Q.advisor_action_timer + ' months.';
}
!}
max-cards: 8

#Here, the main deck will be displayed. Clicking on the deck draws a card into your hand. Clicking on a card activates that card.

[? if year = 1917 and month = 12 : Finland has declared independence. The future of the new nation remains uncertain. ?]

- @finland_parliament
- @party
- @govt
- #advisor
- @shuffle_leadership_pinned

